# Word Count using MapReduce concept

from collections import defaultdict

# Input text
text = input("Enter text: ")

# ---------------- MAP PHASE ----------------
words = text.split()
mapped = [(word, 1) for word in words]

# ---------------- REDUCE PHASE ----------------
result = defaultdict(int)

for key, value in mapped:
    result[key] += value

# Output
print("\nWord Count:")
for k, v in result.items():
    print(k, ":", v)
